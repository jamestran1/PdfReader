# Analyzer + style config (#126, ADR 0007).
# warning = blocks on lines a PR adds or changes (scripts/check.ps1); suggestion = IDE only.
root = true

[*.cs]
indent_style = space
indent_size = 4

# Style already used in the code base
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

csharp_style_var_when_type_is_apparent = true
csharp_style_var_for_built_in_types = false
csharp_style_var_elsewhere = false

csharp_prefer_braces = when_multiline
dotnet_diagnostic.IDE0011.severity = warning

# Private fields: _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# Complexity (CA1502 threshold lives in CodeMetricsConfig.txt)
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1506.severity = warning
dotnet_diagnostic.CA1725.severity = warning
dotnet_diagnostic.MVVMTK0042.severity = warning

# CODING_STANDARDS.md CS-4: only catch what you can handle (boundaries may suppress with a reason)
dotnet_diagnostic.CA1031.severity = warning
# Dead code and readonly fields; IDE0005 needs GenerateDocumentationFile (Directory.Build.props)
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
# CODING_STANDARDS.md CS-13: async methods end with Async
dotnet_diagnostic.MA0137.severity = warning

# Meziantou: everything stays at its default except
# MA0004 ConfigureAwait(false) breaks the WPF UI thread; MA0007 trailing comma
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0007.severity = none
# MA0003 name bool arguments; MA0006 string.Equals instead of ==
dotnet_diagnostic.MA0003.severity = suggestion
dotnet_diagnostic.MA0006.severity = suggestion
dotnet_diagnostic.MA0048.severity = warning
dotnet_diagnostic.MA0051.severity = warning
MA0051.maximum_lines_per_method = 60
MA0051.maximum_statements_per_method = 40

# Test names use underscores; test data uses constant arrays
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
# xUnit test methods are async Task without the Async suffix
dotnet_diagnostic.MA0137.severity = none
