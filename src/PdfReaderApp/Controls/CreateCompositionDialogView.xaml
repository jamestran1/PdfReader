<UserControl x:Class="PdfReaderApp.Controls.CreateCompositionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Hộp thoại "Tạo Bản soạn" (#292, prototype #251 biến thể B). DataContext là CreateCompositionDialogViewModel.
         Trái: cây Workspace, Document, Note. Phải: kiểu, yêu cầu thêm, ngân sách, nút Tạo. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="TriThu.Dialog.Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Lựa chọn kiểu: thẻ bo góc 12 (UI-2), chọn = secondary-container -->
        <Style x:Key="TriThu.Dialog.KindItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource TriThu.Brush.SecondaryContainer}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TriThu.Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TriThu.Brush.Outline}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource TriThu.Brush.SurfaceTonalLowest}" CornerRadius="16"
            BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}" BorderThickness="1">
        <DockPanel Margin="20">
            <TextBlock DockPanel.Dock="Top" Text="Tạo Bản soạn" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"
                       Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: cây Note -->
                <DockPanel Grid.Column="0">
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Tìm Note"
                             Text="{Binding Tree.FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox DockPanel.Dock="Top" IsThreeState="True" Margin="0,0,0,4" FontWeight="SemiBold"
                              IsChecked="{Binding Tree.IsChecked}" Content="Toàn bộ Workspace"
                              Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>
                    <TextBlock DockPanel.Dock="Top" Margin="26,0,0,8" FontSize="12"
                               Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"
                               Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="{Binding Tree.SelectedCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Tree.TotalCount, Mode=OneWay}"/><Run Text=" Note được chọn"/>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="340">
                        <ItemsControl ItemsSource="{Binding Tree.Documents}" Margin="14,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                                       Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                                            <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked}" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TriThu.Brush.OnSurface}">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                            </CheckBox>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Notes}" Margin="26,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PageText}" FontSize="11.5"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                                                            <TextBlock Text="{Binding Summary}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Summary}"
                                                                       Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>
                                                        </DockPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Cột phải: kiểu, yêu cầu, ngân sách, Tạo -->
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TriThu.Brush.Error}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy" Command="{Binding CancelCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    materialDesign:ButtonAssist.CornerRadius="12" Margin="0,0,8,0"/>
                            <Button Content="Tạo" Command="{Binding CreateCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="12" MinWidth="96"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource TriThu.Dialog.Section}" Text="Kiểu"/>
                        <ListBox ItemsSource="{Binding Kinds}" SelectedValuePath="Kind" SelectedValue="{Binding Kind}"
                                 BorderThickness="0" Background="Transparent" Margin="0,0,0,10"
                                 ItemContainerStyle="{StaticResource TriThu.Dialog.KindItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Style="{StaticResource TriThu.Dialog.Section}" Text="Yêu cầu thêm (không bắt buộc)"/>
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="5"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Ví dụ: viết bằng tiếng Anh"
                                 Text="{Binding AdditionalRequest, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource TriThu.Dialog.Section}" Text="Ngân sách"/>
                        <TextBlock Text="{Binding BudgetText}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
