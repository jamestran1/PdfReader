<UserControl x:Class="PdfReaderApp.Controls.WorkspaceRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:PdfReaderApp.Converters"
             xmlns:local="clr-namespace:PdfReaderApp">
    <!-- Rail trái (#291, prototype #252-B): mục DOCUMENT (chỉ Workspace có tên) và mục BẢN SOẠN (cả Default Workspace, #297).
         DataContext là MainViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:CountToInverseVisibilityConverter x:Key="CountToInverseVisibilityConverter"/>
        <converters:IsActiveTabItemConverter x:Key="IsActiveTabItemConverter"/>

        <Style x:Key="TriThu.Rail.SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dòng rail: nút phẳng bo góc 12 (UI-2); dòng của tab đang active = secondary-container. -->
        <Style x:Key="TriThu.Rail.Row" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurface}"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Border Width="240" Background="{DynamicResource TriThu.Brush.SurfaceTonalLow}"
            BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,14,12,12">
            <TextBlock DockPanel.Dock="Top" Text="{Binding DocumentsSurface.WorkspaceName}"
                       FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="10,0,10,14"
                       Foreground="{DynamicResource TriThu.Brush.OnSurface}"
                       Visibility="{Binding Session.IsWorkspaceSession, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Bản soạn: ở đáy rail, có danh sách cuộn riêng -->
            <DockPanel DockPanel.Dock="Bottom" MaxHeight="300" Margin="0,12,0,0">
                <Grid DockPanel.Dock="Top" Margin="10,0,0,6">
                    <TextBlock Text="BẢN SOẠN" Style="{StaticResource TriThu.Rail.SectionHeader}"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32" ToolTip="Tạo Bản soạn"
                            Command="{Binding Compositions.ShowCreateDialogCommand}">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>
                </Grid>
                <DockPanel DockPanel.Dock="Top" Margin="10,2,0,8"
                           Visibility="{Binding Compositions.IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button DockPanel.Dock="Right" Content="Huỷ" Height="28" Padding="10,0" FontSize="12.5"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Command="{Binding Compositions.CancelGenerationCommand}"/>
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Width="16" Height="16" Value="0"/>
                    <TextBlock Text="Đang sinh…" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Chưa có. Bấm ＋ để tạo." FontSize="12.5" Margin="10,2,0,8"
                           Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"
                           Visibility="{Binding Compositions.Items.Count, Converter={StaticResource CountToInverseVisibilityConverter}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Compositions.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid>
                                <Button ToolTip="{Binding Title}"
                                        Command="{Binding DataContext.Compositions.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TriThu.Rail.Row}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsActiveTabItemConverter}" ConverterParameter="Composition">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.Session.Tabs.ActiveTab" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource TriThu.Brush.SecondaryContainer}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.SecondaryContainer.On}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TextBoxOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <!-- Xoá từ rail (#294): hiện khi rê chuột vào hàng, có hộp xác nhận -->
                                <Button HorizontalAlignment="Right" Width="26" Height="26" Margin="0,0,4,0" ToolTip="Xoá"
                                        Command="{Binding DataContext.Compositions.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="Delete" Width="15" Height="15"/>
                                </Button>
                              </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Document của Workspace: bấm để kích hoạt hoặc mở Tab Document -->
            <TextBlock DockPanel.Dock="Top" Text="DOCUMENT" Style="{StaticResource TriThu.Rail.SectionHeader}" Margin="10,0,0,6"
                       Visibility="{Binding Session.IsWorkspaceSession, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Session.IsWorkspaceSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding DocumentsSurface.Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button ToolTip="{Binding Title}"
                                    Command="{Binding DataContext.OpenWorkspaceDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TriThu.Rail.Row}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource IsActiveTabItemConverter}" ConverterParameter="Document">
                                                        <Binding Path="DocumentId"/>
                                                        <Binding Path="DataContext.Session.Tabs.ActiveTab" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource TriThu.Brush.SecondaryContainer}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.SecondaryContainer.On}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
