<UserControl x:Class="PdfReaderApp.Controls.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PdfReaderApp.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Tab Bản soạn (#291): Markdown chỉ đọc trên tờ giấy 680 px (prototype #252-B). DataContext là CompositionTab. -->
    <UserControl.Resources>
        <Style x:Key="TriThu.Composition.Block" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurface}"/>
        </Style>
        <DataTemplate x:Key="HeadingTemplate">
            <TextBlock Text="{Binding Text}" Style="{StaticResource TriThu.Composition.Block}"
                       FontSize="17" FontWeight="Bold" Margin="0,10,0,8"/>
        </DataTemplate>
        <DataTemplate x:Key="ListItemTemplate">
            <DockPanel Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource TriThu.Composition.Block}" Margin="0,0,10,10"/>
                <TextBlock Text="{Binding Text}" Style="{StaticResource TriThu.Composition.Block}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ParagraphTemplate">
            <TextBlock Text="{Binding Text}" Style="{StaticResource TriThu.Composition.Block}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="{DynamicResource TriThu.Brush.Surface}">
        <Border MaxWidth="680" Margin="24,28,24,40" Padding="36,32" VerticalAlignment="Top" CornerRadius="12"
                Background="{DynamicResource TriThu.Brush.SurfaceTonalLowest}"
                BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}" BorderThickness="1"
                Effect="{DynamicResource TriThu.Elevation.E1}">
            <StackPanel>
                <Border HorizontalAlignment="Left" Padding="10,3" CornerRadius="8"
                        Background="{DynamicResource TriThu.Brush.SecondaryContainer}">
                    <TextBlock Text="{Binding KindLabel}" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TriThu.Brush.SecondaryContainer.On}"/>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="26" TextWrapping="Wrap" Margin="0,14,0,4"
                           Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>
                <TextBlock Text="{Binding MetaText}" FontSize="12.5" Margin="0,0,0,20"
                           Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:MarkdownBlock}">
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ParagraphTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                <Setter Property="ContentTemplate" Value="{StaticResource HeadingTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="ListItem">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ListItemTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
