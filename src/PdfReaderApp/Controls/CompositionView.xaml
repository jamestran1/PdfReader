<UserControl x:Class="PdfReaderApp.Controls.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PdfReaderApp.Controls"
             xmlns:core="clr-namespace:PdfReaderApp.Core"
             xmlns:models="clr-namespace:PdfReaderApp.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Tab Bản soạn (#291, #294): Markdown trên tờ giấy 680 px (prototype #252-B), thanh công cụ Sửa/Đổi tên/Sao chép/Xoá/Đóng.
         DataContext là CompositionTab; lệnh nằm ở MainViewModel.Compositions nên bind qua Window. -->
    <UserControl.Resources>
        <!-- Nút icon vuông của thanh công cụ (UI-2: nút icon được miễn bo viên thuốc) -->
        <Style x:Key="TriThu.Composition.ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
        </Style>
        <Style x:Key="TriThu.Composition.Block" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurface}"/>
        </Style>
        <DataTemplate x:Key="HeadingTemplate">
            <TextBlock controls:CitationText.AsChip="True" controls:CitationText.Spans="{Binding Spans}" controls:CitationText.Command="{Binding DataContext.Compositions.Sources.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource TriThu.Composition.Block}"
                       FontSize="17" FontWeight="Bold" Margin="0,10,0,8"/>
        </DataTemplate>
        <DataTemplate x:Key="ListItemTemplate">
            <DockPanel Margin="{Binding ListIndent}">
                <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource TriThu.Composition.Block}" Margin="0,0,10,10"/>
                <TextBlock controls:CitationText.AsChip="True" controls:CitationText.Spans="{Binding Spans}" controls:CitationText.Command="{Binding DataContext.Compositions.Sources.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource TriThu.Composition.Block}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ParagraphTemplate">
            <TextBlock controls:CitationText.AsChip="True" controls:CitationText.Spans="{Binding Spans}" controls:CitationText.Command="{Binding DataContext.Compositions.Sources.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource TriThu.Composition.Block}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="{DynamicResource TriThu.Brush.Surface}">
        <Border MaxWidth="680" Margin="24,28,24,40" VerticalAlignment="Top" CornerRadius="12" SnapsToDevicePixels="True"
                Background="{DynamicResource TriThu.Brush.SurfaceTonalLowest}"
                BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}" BorderThickness="1"
                Effect="{DynamicResource TriThu.Elevation.E1}">
            <StackPanel>
                <!-- Thanh công cụ (prototype #252-B): chip kiểu bên trái, nút icon bên phải, đường kẻ OutlineVariant 1px bên dưới.
                     Sinh lại (#293) nằm giữa Sao chép và Xoá. -->
                <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding DataContext.Compositions.ToggleEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TriThu.Composition.ToolbarButton}">
                                    <Setter Property="ToolTip" Value="Sửa"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="ToolTip" Value="Xong"/>
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <materialDesign:PackIcon Kind="Check" Width="18" Height="18"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource TriThu.Composition.ToolbarButton}" ToolTip="Đổi tên"
                                Command="{Binding DataContext.Compositions.StartRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="FormatTitle" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TriThu.Composition.ToolbarButton}" ToolTip="Sao chép (Markdown)"
                                Command="{Binding DataContext.Compositions.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TriThu.Composition.ToolbarButton}" ToolTip="Sinh lại (tạo bản mới)"
                                Command="{Binding DataContext.Compositions.RegenerateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Composition}">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TriThu.Composition.ToolbarButton}" ToolTip="Xoá"
                                Command="{Binding DataContext.Compositions.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Composition}">
                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TriThu.Composition.ToolbarButton}" ToolTip="Đóng"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                    <materialDesign:Chip HorizontalAlignment="Left" VerticalAlignment="Center" Height="26"
                                         Content="{Binding KindLabel}" FontSize="12" FontWeight="Medium"
                                         materialDesign:ButtonAssist.CornerRadius="8"
                                         Background="{DynamicResource TriThu.Brush.SecondaryContainer}"
                                         Foreground="{DynamicResource TriThu.Brush.SecondaryContainer.On}"/>
                </DockPanel>
                </Border>

                <!-- Thân bài đọc: lề riêng bên dưới thanh công cụ -->
                <StackPanel Margin="20,16,20,18">
                <TextBlock Text="{Binding Title}" FontSize="21" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource TriThu.Brush.OnSurface}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Đổi tên tại chỗ: Enter hoặc rời ô để lưu, Esc để bỏ -->
                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" FontSize="21" TextWrapping="Wrap"
                         Margin="0,0,0,4" materialDesign:HintAssist.Hint="Tên Bản soạn"
                         LostKeyboardFocus="RenameBox_LostKeyboardFocus" IsVisibleChanged="RenameBox_IsVisibleChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding DataContext.Compositions.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        <KeyBinding Key="Esc"
                                    Command="{Binding DataContext.Compositions.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                    </TextBox.InputBindings>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="{Binding MetaText}" FontSize="12.5" Margin="0,0,0,10"
                           Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>

                <!-- Chế độ Sửa: ô Markdown thô, tự lưu khi ngừng gõ và khi rời tab; không có hộp thoại lưu -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="240" FontFamily="Consolas" FontSize="13.5"/>
                    <TextBlock Text="Sửa tay ghi đè nội dung bản này; sinh lại luôn tạo bản mới." FontSize="12" Margin="0,8,0,0"
                               Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding RenderedBlocks}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CompositionBlockView}">
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ParagraphTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                <Setter Property="ContentTemplate" Value="{StaticResource HeadingTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="ListItem">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ListItemTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Danh sách nguồn (#295, prototype #252-B): theo Note hiện tại, Note đã xoá ghi rõ; bấm một dòng để nhảy tới Note -->
                <Border Margin="0,16,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}">
                    <StackPanel>
                        <TextBlock Text="{Binding SourcesMetaText}" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:CompositionSourceEntry}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SourceLine}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TriThu.Brush.OnSurface}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
