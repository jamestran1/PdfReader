<UserControl x:Class="PdfReaderApp.Controls.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PdfReaderApp.Controls"
             xmlns:core="clr-namespace:PdfReaderApp.Core"
             xmlns:models="clr-namespace:PdfReaderApp.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Tab Bản soạn (#291): Markdown chỉ đọc trên tờ giấy 680 px (prototype #252-B). DataContext là CompositionTab. -->
    <UserControl.Resources>
        <Style x:Key="TriThu.Composition.Block" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurface}"/>
        </Style>
        <DataTemplate x:Key="HeadingTemplate">
            <TextBlock controls:CitationText.Spans="{Binding Spans}" controls:CitationText.Command="{Binding DataContext.Compositions.Sources.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource TriThu.Composition.Block}"
                       FontSize="17" FontWeight="Bold" Margin="0,10,0,8"/>
        </DataTemplate>
        <DataTemplate x:Key="ListItemTemplate">
            <DockPanel Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource TriThu.Composition.Block}" Margin="0,0,10,10"/>
                <TextBlock controls:CitationText.Spans="{Binding Spans}" controls:CitationText.Command="{Binding DataContext.Compositions.Sources.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource TriThu.Composition.Block}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ParagraphTemplate">
            <TextBlock controls:CitationText.Spans="{Binding Spans}" controls:CitationText.Command="{Binding DataContext.Compositions.Sources.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource TriThu.Composition.Block}"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="{DynamicResource TriThu.Brush.Surface}">
        <Border MaxWidth="680" Margin="24,28,24,40" Padding="36,32" VerticalAlignment="Top" CornerRadius="12"
                Background="{DynamicResource TriThu.Brush.SurfaceTonalLowest}"
                BorderBrush="{DynamicResource TriThu.Brush.OutlineVariant}" BorderThickness="1"
                Effect="{DynamicResource TriThu.Elevation.E1}">
            <StackPanel>
                <DockPanel>
                    <!-- #293: Sinh lại; lệnh nằm ở CompositionsViewModel của MainViewModel (DataContext của Window) -->
                    <Button DockPanel.Dock="Right" Content="Sinh lại" Height="32" Padding="12,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Command="{Binding DataContext.Compositions.RegenerateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Composition}"/>
                    <Border HorizontalAlignment="Left" Padding="10,3" CornerRadius="8"
                            Background="{DynamicResource TriThu.Brush.SecondaryContainer}">
                        <TextBlock Text="{Binding KindLabel}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TriThu.Brush.SecondaryContainer.On}"/>
                    </Border>
                </DockPanel>
                <TextBlock Text="{Binding Title}" FontSize="26" TextWrapping="Wrap" Margin="0,14,0,4"
                           Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>
                <TextBlock Text="{Binding MetaText}" FontSize="12.5" Margin="0,0,0,20"
                           Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                <ItemsControl ItemsSource="{Binding RenderedBlocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CompositionBlockView}">
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ParagraphTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                <Setter Property="ContentTemplate" Value="{StaticResource HeadingTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="ListItem">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ListItemTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Danh sách nguồn (#295): theo Note hiện tại, Note đã xoá ghi rõ -->
                <Separator Margin="0,18,0,12" Background="{DynamicResource TriThu.Brush.OutlineVariant}"/>
                <TextBlock Text="Nguồn" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TriThu.Brush.OnSurface}"/>
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:CompositionSourceEntry}">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="32" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Location}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" FontSize="13.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TriThu.Brush.OnSurface}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding GeneratedText}" FontSize="12.5" Margin="0,8,0,0"
                           Foreground="{DynamicResource TriThu.Brush.OnSurfaceVariant}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
