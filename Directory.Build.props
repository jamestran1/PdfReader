<Project>
  <!-- Analyzer config (#126, ADR 0007). Inspector_* is out of scope. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('Inspector'))">
    <!-- Pinned so an SDK upgrade does not turn on new rules by itself. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Read by scripts/check.ps1; obj/ keeps it valid across incremental builds. -->
    <ErrorLog>$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.StartsWith('Inspector'))">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.316" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>
</Project>
