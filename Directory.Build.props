<Project>
  <!-- Measurement only (wayfinder ticket #117). Never merged. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ErrorLog>$(MSBuildThisFileDirectory)sarif\$(MeasureTag)\$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)measure.globalconfig" />
  </ItemGroup>
  <ItemGroup Condition="'$(WithPackages)' == 'true'">
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.316" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" /></ItemGroup>
</Project>
